{
  "meta": {
    "name": "sky130-process-tech figure tokens",
    "version": "1.0",
    "note": "Single source of truth for every figure: colours, type scale, spacing and stroke values live here and nowhere else. Light and dark values are paired; a figure never uses a colour that is not a token. Units are SVG user units (u); a figure is 480 u wide and is displayed at 560 CSS px on desktop (1 u = 1.17 px) and about 360 px on a phone (1 u = 0.75 px), so 13 u text is 15 px on desktop and about 10 px on a phone."
  },
  "theme": {
    "bg": {
      "light": "#ffffff",
      "dark": "#131416",
      "use": "figure ground; equals furo's page background so a matched figure is seamless"
    },
    "ink": {
      "light": "#1b1f24",
      "dark": "#e4e6e9",
      "use": "outlines, label titles, arrowheads"
    },
    "ink-muted": {
      "light": "#545d68",
      "dark": "#a9b1ba",
      "use": "label notes, leaders, dimension lines, 'not to scale'"
    },
    "rule": {
      "light": "#c4cad1",
      "dark": "#3a3f46",
      "use": "hairlines, row separators, panel rules"
    },
    "halo": {
      "light": "#ffffff",
      "dark": "#131416",
      "use": "halo under a leader where it crosses a filled material"
    },
    "accent": {
      "light": "#0a58b0",
      "dark": "#6ab0ff",
      "use": "the one thing that changes in this step: process arrow, ion arrows, highlight outline"
    },
    "inferred": {
      "light": "#9a5b00",
      "dark": "#e0a84a",
      "use": "tag text and dashed outline for anything the page marks as inferred, typical or 'our reading'"
    }
  },
  "materials": {
    "si-sub": {
      "label": "Silicon substrate (p-type)",
      "light": "#c6cbd1",
      "dark": "#454b54",
      "pattern": "none"
    },
    "well-n": {
      "label": "N-well",
      "light": "#a3cdf5",
      "dark": "#2b6196",
      "pattern": "none"
    },
    "well-p": {
      "label": "P-well",
      "light": "#f7b3cd",
      "dark": "#8f4468",
      "pattern": "plus"
    },
    "well-dn": {
      "label": "Deep N-well",
      "light": "#7fb0e0",
      "dark": "#1f4d7a",
      "pattern": "hlines"
    },
    "sd-n": {
      "label": "N+ source/drain, N+ gate poly",
      "light": "#2f7fd1",
      "dark": "#5aa5ee",
      "pattern": "none"
    },
    "tip-n": {
      "label": "n-type tip (source/drain extension)",
      "light": "#8cc3f2",
      "dark": "#3b78b8",
      "pattern": "xhatch"
    },
    "sd-p": {
      "label": "P+ source/drain, p-type poly resistor body",
      "light": "#c43d83",
      "dark": "#e57db4",
      "pattern": "plus"
    },
    "implant": {
      "label": "Channel implant (n- or p-type not shown: ink hatching over the silicon's own colour)",
      "light": "#1b1f24",
      "dark": "#e4e6e9",
      "pattern": "vlines-ink",
      "fill": "none"
    },
    "oxide-thermal": {
      "label": "Thermal oxide (pad, liner, gate, screen)",
      "light": "#e3b92e",
      "dark": "#ecd05a",
      "pattern": "none"
    },
    "oxide-dep": {
      "label": "Deposited oxide (field oxide, inter-level dielectric, cap oxide, TOPOX)",
      "light": "#f7e9a8",
      "dark": "#9a8c52",
      "pattern": "none"
    },
    "psg": {
      "label": "Phosphosilicate glass (PSG)",
      "light": "#efe0b4",
      "dark": "#bdb391",
      "pattern": "dots"
    },
    "nitride": {
      "label": "Silicon nitride (hard mask, spacer, LINT, TOPNIT)",
      "light": "#74c7a5",
      "dark": "#2f8f6f",
      "pattern": "hatch"
    },
    "ono": {
      "label": "ONO charge-trap stack",
      "light": "#2d3e6e",
      "dark": "#aab9ea",
      "pattern": "hlines"
    },
    "poly": {
      "label": "Polysilicon",
      "light": "#d9662b",
      "dark": "#d2571f",
      "pattern": "none"
    },
    "resist": {
      "label": "Photoresist",
      "light": "#b49ce0",
      "dark": "#7d63bd",
      "pattern": "dots"
    },
    "arc": {
      "label": "Anti-reflective coating (ARC) under a resist",
      "light": "#8a6a50",
      "dark": "#8f6a55",
      "pattern": "none"
    },
    "silicide": {
      "label": "Titanium silicide",
      "light": "#1f6f6c",
      "dark": "#46c4ba",
      "pattern": "none"
    },
    "barrier": {
      "label": "Ti / TiN / TiW (liner, barrier, cap, local interconnect, MiM plate)",
      "light": "#3d2f5b",
      "dark": "#d8cdf7",
      "pattern": "none"
    },
    "tungsten": {
      "label": "Tungsten plug",
      "light": "#5b6673",
      "dark": "#98a3af",
      "pattern": "xhatch"
    },
    "aluminium": {
      "label": "Aluminium-copper metal",
      "light": "#b3c0cc",
      "dark": "#6c7b8a",
      "pattern": "hatch-back"
    },
    "mim-diel": {
      "label": "MiM capacitor dielectric",
      "light": "#c69a55",
      "dark": "#d4ae5c",
      "pattern": "vlines"
    },
    "polyimide": {
      "label": "Polyimide",
      "light": "#dcb98f",
      "dark": "#7a5f40",
      "pattern": "hlines"
    }
  },
  "material-groups": {
    "silicon": [
      "si-sub",
      "well-n",
      "well-p",
      "well-dn",
      "sd-n",
      "tip-n",
      "sd-p",
      "implant"
    ],
    "oxide": [
      "oxide-thermal",
      "oxide-dep",
      "psg"
    ],
    "metal": [
      "barrier",
      "tungsten",
      "aluminium",
      "silicide"
    ]
  },
  "phases": {
    "feol": {
      "label": "FEOL",
      "light": "#9cc4ea",
      "dark": "#2f5f8d",
      "tint": {
        "light": "#e7f1fa",
        "dark": "#1b2a38"
      }
    },
    "mol": {
      "label": "MOL",
      "light": "#f0c060",
      "dark": "#8a6a1f",
      "tint": {
        "light": "#fbf1dc",
        "dark": "#2e2717"
      }
    },
    "beol": {
      "label": "BEOL",
      "light": "#86cdb4",
      "dark": "#2c7d65",
      "tint": {
        "light": "#e4f4ee",
        "dark": "#182b25"
      }
    }
  },
  "type": {
    "family": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, 'Liberation Sans', 'DejaVu Sans', sans-serif",
    "family-mono": "'SFMono-Regular', Menlo, Consolas, 'Liberation Mono', 'DejaVu Sans Mono', monospace",
    "measure-font": "DejaVuSans (widest common fallback; all width estimates use it so real renderings are never wider)",
    "sizes": {
      "panel-title": {
        "size": 14,
        "weight": 700,
        "line": 18
      },
      "label-title": {
        "size": 14,
        "weight": 600,
        "line": 17
      },
      "label-note": {
        "size": 13,
        "weight": 400,
        "line": 16
      },
      "mono": {
        "size": 12.5,
        "weight": 400,
        "line": 16
      },
      "min-size": 12.5
    }
  },
  "space": {
    "canvas-width": 480,
    "display-width-px": 560,
    "margin": 12,
    "drawing-width": 268,
    "gutter": 48,
    "label-column": 140,
    "label-gap": 7,
    "text-clearance": 3,
    "panel-gap": 14,
    "min-layer-thickness": 5,
    "top-route-row": 18,
    "ion-arrow-length": 36,
    "ion-arrow-gap": 6,
    "ion-arrow-pitch": 30,
    "header-band-gap": 8,
    "stack-bar-width": 250,
    "stack-axis-gap": 8,
    "stack-max-height": 520,
    "stack-tick-length": 5,
    "chain-box-padding": 7,
    "chain-arrow-length": 16,
    "chain-branch-gutter": 14,
    "chain-branch-fraction": 0.36,
    "lane-inset": 5,
    "lane-pitch": 6,
    "lane-end-gap": 8,
    "leader-lane-clearance": 4,
    "anchor-separation-x": 8,
    "anchor-separation-y": 10,
    "anchor-stagger": 9,
    "highlight-offset": 3,
    "min-highlight-thickness": 8,
    "max-noted-labels": 3,
    "max-labelled-layers": 6,
    "max-header-callouts": 2,
    "max-callout-note-lines": 2,
    "min-hang-width": 110,
    "max-leader-traverse": 40,
    "max-edge-run": 20,
    "edge-clearance": 6,
    "over-gap": 11,
    "max-title-chars": 30,
    "max-note-chars": 90,
    "max-panel-title-chars": 110,
    "max-figure-height": 800,
    "max-arrow-note-chars": 130,
    "max-parallel-leg": 48,
    "max-label-drop": 12
  },
  "stroke": {
    "outline": 1.0,
    "leader": 0.9,
    "leader-halo": 2.6,
    "dimension": 0.9,
    "rule": 0.75,
    "pattern": 0.7,
    "pattern-opacity": 0.38,
    "process-arrow": 2.0,
    "anchor-dot-radius": 1.9,
    "arrowhead": {
      "length": 7,
      "width": 5
    },
    "highlight": 2.4,
    "halo-opacity": 0.85,
    "faded-fill-opacity": 0,
    "faded-dash": "3 2",
    "ion-arrow": 1.8,
    "chain-box": 1.0,
    "chain-arrow": 1.6,
    "ink-hatch": 0.8,
    "ink-hatch-opacity": 0.8
  }
}
